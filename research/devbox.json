{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "go@1.22",
    "graphviz",
    "clang@17",
    "ripgrep",
    "universal-ctags",
    "python3"
  ],
  "env": {
    "MESA_SRC": "$PWD/../mesa/workdir/mesa"
  },
  "shell": {
    "init_hook": [
      "export MESA_SRC=\"$PWD/../mesa/workdir/mesa\"",
      "mkdir -p output output/traces output/diffs",
      "echo 'Turnip gen8 Laboratory ready'",
      "echo '  Mesa source: $MESA_SRC'",
      "echo '  Index:        scripts/index-functions.sh'",
      "echo '  Search gen8:  scripts/search-gen8.sh'",
      "echo '  Build index:  go run ./cmd/index-builder --mesa $MESA_SRC'",
      "echo '  Build graph:  go run ./cmd/graph-builder --input output/index.json'"
    ],
    "scripts": {
      "index": "go run ./cmd/index-builder --mesa $MESA_SRC --out output/index.json",
      "graph": "go run ./cmd/graph-builder --input output/index.json --outdir output/",
      "all": "go run ./cmd/index-builder --mesa $MESA_SRC --out output/index.json && go run ./cmd/graph-builder --input output/index.json --outdir output/ && echo Done! Diagrams in output/"
    }
  }
}
