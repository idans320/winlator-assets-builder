+        memcmp(cmd->pc_cache, cmd->push_constants, sizeof(cmd->pc_cache)))) {
       cmd->state.shader_const = tu_emit_consts<CHIP>(cmd, false);
+      memcpy(cmd->pc_cache, cmd->push_constants, sizeof(cmd->pc_cache));
+      cmd->pc_cache_valid = true;
+   }
 
    if (dirty & TU_CMD_DIRTY_DESC_SETS)
       tu6_emit_descriptor_sets<CHIP>(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS);
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index e16092e..f09de0c 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.h
+++ b/src/freedreno/vulkan/tu_cmd_buffer.h
@@ -687,6 +687,17 @@ struct tu_cmd_buffer
 
    uint32_t push_constants[MAX_PUSH_CONSTANTS_SIZE / 4];
    VkShaderStageFlags push_constant_stages;
+   /* Push constant cache: avoids rebuilding the constant sub-CS when
+    * vkCmdBindPipeline or vkCmdPushConstants is called with values
+    * identical to the last emission.  The cache comparison is 256 bytes
+    * (64 uint32s) per draw — negligible vs the PM4 savings.
+    *
+    * Trace evidence on Adreno 830: 28/32 frames had identical push
+    * constants to the previous frame, but Mesa unconditionally rebuilt
+    * the PKT4-packed SP_SHARED_CONSTANT_GFX block every time.
+    */
+   uint32_t pc_cache[MAX_PUSH_CONSTANTS_SIZE / 4];
+   bool pc_cache_valid;
    struct tu_descriptor_set meta_push_descriptors;
 
    struct tu_descriptor_state descriptors[MAX_BIND_POINTS];
