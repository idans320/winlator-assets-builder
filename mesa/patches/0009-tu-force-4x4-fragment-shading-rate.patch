From 47781c977d831d6800726b53cc5fb7716b3ff52f Mon Sep 17 00:00:00 2001
From: builder <builder@winlator>
Date: Wed, 11 Nov 2026 21:11:15 +0200
Subject: [PATCH] tu: force a 4x4 fragment shading rate

Pin every draw and clear to 4x4 VRS: one fragment shader invocation
covers 16 pixels, so fragment work and the GMEM tile footprint drop
roughly 16x.  The A800 in the target device is not fragment-bound at
native resolution, so this is a thermal/bandwidth lever rather than a
throughput one, and it is visible: the image is deliberately pixelated.

- tu6_emit_fragment_shading_rate: emit the 4x4 configuration for the
  no-FSR/disabled case and override the requested size in the FSR path.
- r3d_setup: match the same rate for clears and blits, otherwise a blit
  would run at a different rate than the draws around it.
- tu6_init_static_regs: point both quality-lookup tables at 4x4 so
  attachment shading rate cannot ask for a finer rate.
- tu_emit_vrs_force_4x4 writes RB/SP/GRAS directly instead of going
  through tu_cs_emit_regs three times.

Revert this patch on its own to get the application's requested shading
rate back.
---
 src/freedreno/vulkan/tu_clear_blit.cc |  7 ++++---
 src/freedreno/vulkan/tu_cmd_buffer.cc |  8 ++++----
 src/freedreno/vulkan/tu_cs.h          | 13 +++++++++++++
 src/freedreno/vulkan/tu_pipeline.cc   | 16 ++++++++++------
 4 files changed, 31 insertions(+), 13 deletions(-)

diff --git a/src/freedreno/vulkan/tu_clear_blit.cc b/src/freedreno/vulkan/tu_clear_blit.cc
index e5bfd00..9dd8bf3 100644
--- a/src/freedreno/vulkan/tu_clear_blit.cc
+++ b/src/freedreno/vulkan/tu_clear_blit.cc
@@ -1792,9 +1792,10 @@ r3d_setup(struct tu_cmd_buffer *cmd,
       tu_cs_emit_regs(cs, GRAS_LRZ_CNTL2(CHIP, 0));
       tu_cs_emit_regs(cs, GRAS_LRZ_DEPTH_BUFFER_INFO(CHIP));
 
-      tu_cs_emit_regs(cs, A6XX_RB_VRS_CONFIG());
-      tu_cs_emit_regs(cs, SP_VRS_CONFIG(CHIP));
-      tu_cs_emit_regs(cs, GRAS_VRS_CONFIG(CHIP));
+      /* Match the 4x4 rate forced by the draw path. */
+      tu_emit_vrs_force_4x4(cs,
+         (CHIP >= A8XX ? 0x8208 : 0x80f4),
+         0x00000015 /* GRAS_VRS: pipeline_fsr=1, 4x4, KEEP, CLAMP_4x4 */);
    }
 
    /* We need to handle overlapping blits the same as feedback loops, which
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 607c3a8..e00412f 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -2200,11 +2200,11 @@ tu6_init_static_regs(struct tu_device *dev, struct tu_cs *cs)
       tu_cs_emit_write_reg(cs, magic_reg.reg, value);
    }
 
+   /* Point every quality-lookup entry at 4x4 so attachment shading rate
+    * cannot request a finer rate than the draw path forces. */
    if (dev->physical_device->info->props.has_attachment_shading_rate) {
-      tu_cs_emit_regs(cs, GRAS_LRZ_QUALITY_LOOKUP_TABLE_REG(CHIP, 0,
-                           fd_gras_shading_rate_lut(0)));
-      tu_cs_emit_regs(cs, GRAS_LRZ_QUALITY_LOOKUP_TABLE_REG(CHIP, 1,
-                           fd_gras_shading_rate_lut(1)));
+      tu_cs_emit_regs(cs, GRAS_LRZ_QUALITY_LOOKUP_TABLE_REG(CHIP, 0, 0x44444444));
+      tu_cs_emit_regs(cs, GRAS_LRZ_QUALITY_LOOKUP_TABLE_REG(CHIP, 1, 0x44444444));
    }
 
    if (CHIP < A8XX) {
diff --git a/src/freedreno/vulkan/tu_cs.h b/src/freedreno/vulkan/tu_cs.h
index b41a489..17534b0 100644
--- a/src/freedreno/vulkan/tu_cs.h
+++ b/src/freedreno/vulkan/tu_cs.h
@@ -423,6 +423,19 @@ tu_cs_emit_write_reg(struct tu_cs *cs, uint16_t reg, uint32_t value)
    tu_cs_emit(cs, value);
 }
 
+/* Emit the three VRS registers that force a 4x4 shading rate.  Writing
+ * them directly skips the per-register struct setup and bounds checks in
+ * tu_cs_emit_regs.  RB and SP sit at fixed offsets; the caller passes the
+ * chip-appropriate GRAS address and value.
+ */
+static inline void
+tu_emit_vrs_force_4x4(struct tu_cs *cs, uint16_t gras_reg, uint32_t gras_val)
+{
+   tu_cs_emit_write_reg(cs, 0x88f4, 0x00000014); /* RB_VRS_CONFIG */
+   tu_cs_emit_write_reg(cs, 0xa9ad, 0x00000001); /* SP_VRS_CONFIG */
+   tu_cs_emit_write_reg(cs, gras_reg, gras_val); /* GRAS_VRS_CONFIG */
+}
+
 /**
  * Emit a CP_INDIRECT_BUFFER command packet.
  */
diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 0a6bee9..0c53ca9 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -3826,10 +3826,15 @@ tu6_emit_fragment_shading_rate(struct tu_cs *cs,
    /* gl_ShadingRateEXT don't read 1x1 value with null config, so
     * if it is read - we have to emit the config.
     */
+   /* Force a 4x4 shading rate: one fragment shader invocation covers 16
+    * pixels, which shrinks the GMEM footprint proportionally.  This
+    * deliberately overrides the rate the application asked for and trades
+    * image quality (visible pixelation) for fragment work.
+    */
    if (!fsr || (!fs_reads_fsr && vk_fragment_shading_rate_is_disabled(fsr))) {
-      tu_cs_emit_regs(cs, A6XX_RB_VRS_CONFIG());
-      tu_cs_emit_regs(cs, SP_VRS_CONFIG(CHIP));
-      tu_cs_emit_regs(cs, GRAS_VRS_CONFIG(CHIP));
+      tu_emit_vrs_force_4x4(cs,
+         (CHIP >= A8XX ? 0x8208 : 0x80f4),
+         0x00001165 /* GRAS_VRS: pipeline_fsr=1, 4x4, REPLACE, CLAMP_16_SAMP */);
       return;
    }
 
@@ -3868,9 +3873,8 @@ tu6_emit_fragment_shading_rate(struct tu_cs *cs,
                                  .primitive_fsr_enable = enable_prim_fsr));
    tu_cs_emit_regs(
       cs, GRAS_VRS_CONFIG(CHIP,
-                .pipeline_fsr_enable = enable_draw_fsr,
-                .frag_size_x = util_logbase2(frag_width),
-                .frag_size_y = util_logbase2(frag_height),
+                .pipeline_fsr_enable = true,
+                .frag_size_x = 2, .frag_size_y = 2,
                 .combiner_op_1 = (a6xx_fsr_combiner) fsr->combiner_ops[0],
                 .combiner_op_2 = (a6xx_fsr_combiner) fsr->combiner_ops[1],
                 .combiner_clamp_mode = (CHIP >= A8XX) ? FSR_COMBINER_CLAMP_16_SAMP : FSR_COMBINER_CLAMP_4x4,
-- 
