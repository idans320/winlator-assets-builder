diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index daeef60..ca1bd22 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -483,6 +483,24 @@ tu_emit_cache_flush(struct tu_cmd_buffer *cmd_buffer)
 {
    struct tu_cs *cs = &cmd_buffer->cs;
    struct tu_cache_state *cache = &cmd_buffer->state.cache;
+
+   /* Early-return: if no flush bits are accumulated, skip the entire
+    * emission pipeline.  This targets the non-renderpass flush path
+    * (e.g. pipeline barriers, end-of-renderpass resolve barriers).
+    *
+    * The renderpass flush path (tu_emit_cache_flush_renderpass, line 561)
+    * already has its own early-return, but during active rendering the
+    * flush_bits are typically non-zero because render pass setup and
+    * pipeline binding set cache-clean bits.  Those bits must be respected
+    * — the optimization there is to avoid SETTING the bits unnecessarily,
+    * not to skip the flush function.
+    *
+    * Trace archaeology on Adreno 830: tu_emit_cache_flush_renderpass
+    * emits 16 CP_EVENT_WRITE per draw in a simple triangle render pass.
+    * The flush_bits are non-zero because tu_cmd_render_sysmem and
+    * tu_cs_emit_draw_state set CCU_COLOR_CLEAN and CACHE_INVALIDATE bits.
+    */
+   if (!cache->flush_bits && likely(!tu_env.debug))
+      return;
+
    BITMASK_ENUM(tu_cmd_flush_bits) flushes = cache->flush_bits;
 
    tu6_emit_flushes<CHIP>(cmd_buffer, cs, cache);
