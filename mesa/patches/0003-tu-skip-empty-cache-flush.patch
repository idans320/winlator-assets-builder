From fa687e1c92da398b4f659c9357d3abc4b2583f7d Mon Sep 17 00:00:00 2001
From: builder <builder@winlator>
Date: Sat, 14 Nov 2026 17:41:00 +0200
Subject: [PATCH] tu: skip cache flush emission when no bits are pending

tu6_emit_flushes emits nothing when flush_bits is zero, but callers still
walk its chain of bit tests. Mirror the early return that
tu_emit_cache_flush_renderpass already uses.
---
 src/freedreno/vulkan/tu_cmd_buffer.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 01f0aa6..b84c4ba 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -545,6 +545,10 @@ template <chip CHIP>
 void
 tu_emit_cache_flush(struct tu_cmd_buffer *cmd_buffer)
 {
+   if (!cmd_buffer->state.cache.flush_bits &&
+       likely(!tu_env.debug))
+      return;
+
    struct tu_cs *cs = &cmd_buffer->cs;
    struct tu_cache_state *cache = &cmd_buffer->state.cache;
    BITMASK_ENUM(tu_cmd_flush_bits) flushes = cache->flush_bits;
-- 
2.55.0

